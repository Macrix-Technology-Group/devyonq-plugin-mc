  "steps": {
    "write-lock": {
      "fields": [
        "path",
        "base64"
      ]
    },
    "commit-wave": {
      "fields": [
        "paths",
        "message",
        "token"
      ],
      "mid-run": true,
      "pathFields": [
        "path",
        "change",
        "base64"
      ],
      "note": "each path reads as write-file's places"
    },
    "write-file": {
      "fields": [
        "path",
        "base64",
        "remove"
      ],
      "note": "in the checkout the engine writes, removes or clears only under .mc17/; at a path that a --out, --save-suites (its prefix and a dot) or --record-fingerprint of the command's own words names, as the client sent them, or under it; at the record {title}.written.json in the command's folder; where the command's words name --title, at {title}.md and {title}.written.json of that title in the command's folder or in the folder of a --out path the words name (mc17 create --render with no --out writes {title}.md in the command's folder, and with --out sub/x.md writes its record at sub/{title}.written.json); the work folder /~work, the converge store and the temporary folder /~tmp stand open by their places. A command that would write elsewhere meets harness-path-refused in the engine, and no step names such a path. The drill's proofs file harness/BREAK-PROOFS.json never goes as write-file: the engine sends it as restore-file, or puts it back as git-write checkout-file"
    },
    "git-write": {
      "fields": [
        "form",
        "path",
        "commit"
      ],
      "forms": [
        "worktree-add",
        "worktree-remove",
        "checkout-file"
      ],
      "mid-run": true,
      "note": "worktree-add and worktree-remove name a folder of the temporary folder /~tmp alone; checkout-file names a path of write-file's places or the drill's proofs file harness/BREAK-PROOFS.json"
    },
    "restore-file": {
      "fields": [
        "path",
        "base64"
      ],
      "note": "the drill's proofs file harness/BREAK-PROOFS.json, at any folder of the checkout, written by the drill and written back after it, always as this step and never as write-file; any other path reads as write-file's places"
    },
    "set-hooks-path": {
      "fields": [],
      "hooks": {
        "pre-commit": "sha256:c3cb20ffad7b80f3293b53a01a466d8b0f8aefac2269c1be9e125140444b40bf",
        "pre-merge-commit": "sha256:b5e9e2a7dcab80ca890322d17ef4893f2269ec99a9a35ee6d0a9f0dbe12e7e1d"
      },
      "note": "mc17 wave hooks sends this step alone, with no write-file step of the hooks: the client writes its own copy of each hook under .mc17/hooks, which carries the sha256 named here, and points core.hooksPath there; the engine sends no other write under .mc17/hooks, and a core.hooksPath that names another folder has no client form"
    },
    "store-decision": {
      "fields": [
        "lines",
        "decision",
        "signature",
        "keyId"
      ]
    },
    "write-brief": {
      "fields": [
        "path",
        "base64"
      ]
    },
    "clear": {
      "fields": [
        "what",
        "path",
        "base64"
      ],
      "what": [
        "registry",
        "hand",
        "clone-lock"
      ]
    }
  },
