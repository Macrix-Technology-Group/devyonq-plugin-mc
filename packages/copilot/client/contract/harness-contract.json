        "base-figures"
      ],
      "baseFigures": {
        "figures": {
          "maxItems": 64,
          "maxChars": 1000,
          "timeMs": 1000
        },
        "counts": "`{file}:{line}` and the digits of each matched count apart by a space, ` on {Windows|macOS|Linux}` after a count by host, the counts of one line apart by ' and ' and by ', ', the lines apart by '; '; no other word of a text",
        "note": "the engine sends at most figures.maxItems count figures, each { in, line, re } with line and re as [source, flags] of figures.maxChars characters at most; the client runs them within figures.timeMs milliseconds and answers a problem past it. The answer's blockHash and blockLines read null: the engine reads the block's figures from its own copy's sanctioned block"
      }
    }
