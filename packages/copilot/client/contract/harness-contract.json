{
  "form": "mc-harness-contract/1",
  "version": 1,
  "base": "/api/v1/tenants/{tenantId}/devyonq/harness",
  "header": "MC-Harness-Contract",
  "refusalForm": "each refusal answers in the platform's problem form: its status, type about:blank, and a detail that opens with the refusal's type and a colon, '<type>: <sentence>'; the client reads the type from the detail",
  "routes": [
    {
      "id": "session",
      "method": "POST",
      "path": "/session",
      "bodyLimitBytes": 65536,
      "kind": "read",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "answer": {
        "type": "object",
        "required": [
          "person",
          "writer",
          "tenant",
          "instance",
          "contractVersion",
          "checkingKeys"
        ],
        "properties": {
          "person": {
            "type": "string"
          },
          "writer": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "contractVersion": {
            "type": "integer"
          },
          "checkingKeys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "keyId",
                "publicKey"
              ],
              "properties": {
                "keyId": {
                  "type": "string"
                },
                "publicKey": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "reads",
      "method": "GET",
      "path": "/reads/{kind}",
      "bodyLimitBytes": 0,
      "kind": "read",
      "answer": {
        "type": "object",
        "required": [
          "kind",
          "content"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "content": {},
          "etag": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "id": "commands",
      "method": "POST",
      "path": "/commands",
      "bodyLimitBytes": 4194304,
      "kind": "by command",
      "request": {
        "type": "object",
        "required": [
          "command",
          "args",
          "instance",
          "files",
          "facts"
        ],
        "additionalProperties": false,
        "properties": {
          "requestKey": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "sha256",
                "base64"
              ],
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "base64": {
                  "type": "string"
                }
              }
            }
          },
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "git": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "root": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "remote": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 4096,
                    "description": "the checkout's remote URL, with the user-info of a scheme://user[:password]@host/... form stripped by the client; the form [user@]host:path is sent as it stands. The engine strips it again, and the checkout digest of a decision reads the remote so stripped"
                  },
                  "branch": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 4096
                  },
                  "head": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 4096
                  },
                  "cwd": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              },
              "locks": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 1048576
                },
                "maxProperties": 4
              },
              "store": {
                "type": "array",
                "maxItems": 256
              },
              "processes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "pid",
                    "startedAt",
                    "pattern"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "pid": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "startedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "pattern": {
                      "type": "string",
                      "maxLength": 1024
                    }
                  }
                },
                "maxItems": 1024
              },
              "host": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cores": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "load": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "os": {
                    "type": "string",
                    "enum": [
                      "linux",
                      "macos",
                      "windows"
                    ]
                  },
                  "samples": {
                    "type": "array",
                    "maxItems": 1200,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 64
                        },
                        "load": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "cores": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4096
                        }
                      }
                    }
                  }
                }
              },
              "plugin": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "folder": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "before": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "commit": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              },
              "runnerBlockHash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "answer": {
        "$ref": "#/answers/job"
      }
    },
    {
      "id": "uploads",
      "method": "POST",
      "path": "/uploads",
      "bodyLimitBytes": 42008576,
      "kind": "write",
      "request": {
        "$ref": "#/routes/2/request"
      },
      "answer": {
        "$ref": "#/answers/job"
      }
    },
    {
      "id": "jobs",
      "method": "POST",
      "path": "/jobs/{jobId}",
      "bodyLimitBytes": 4194304,
      "kind": "by command",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "answer": {
        "$ref": "#/answers/job"
      },
      "pollWithinSeconds": 30,
      "note": "a job no poll or answer reached for the abandonment window (120 s) ends abandoned; the window counts from the client's last contact, so while it carries out a long ask, such as a run-test, the client polls the job with no answers at least every pollWithinSeconds seconds. Whatever the polls, a job still running commandWallSeconds after it started, or whose ask the client has not answered askWallSeconds after it was made, ends abandoned. A command that finds no place waits in a queue of 16, of which 4 are one person's and 8 one tenant's at most; one more is refused with harness-request-refused (all interim figures, to be measured on production)",
      "commandWallSeconds": 900,
      "askWallSeconds": 600
    },
    {
      "id": "decision-start",
      "method": "POST",
      "path": "/decisions/{decisionId}/start",
      "bodyLimitBytes": 65536,
      "kind": "decision",
      "request": {
        "type": "object",
        "required": [
          "entry",
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "entry": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "answer": {
        "type": "object"
      }
    }
  ],
  "decision": {
    "form": "mc-harness-decision/1",
    "signed": [
      "form",
      "decisionId",
      "keyId",
      "issuedAt",
      "point",
      "action",
      "command",
      "wave",
      "scope",
      "plan",
      "checkout",
      "facts"
    ],
    "signature": "Ed25519 over the canonical JSON of the signed fields (each absent field as null), as base64url of its 64 bytes; a signed decision travels as {decision, signature}",
    "digests": {
      "command": "the sha256 in hex of the exact command line or agent prompt",
      "checkout": "the sha256 in hex of the JSON array [remote, root, branch], root the sha256 in hex of the top's path with /",
      "wave": "the sha256 in hex of the JSON array [the lock's wavePlan, the lock's rulingRecord]",
      "scope": "the Mission's scope as text, {SCOPE} of the Wave Plan's name WAVE-PLAN-{SCOPE}-{NNN}: for a test command the scope of the ruled plan it comes from, which the lock's wavePlanName names too; for any other point the scope of the lock's wavePlanName; null where none is read",
      "plan": "the lock's planBinding",
      "facts": "the start entry's inputDigest, or the inputDigest of its operation's saved line in ops.jsonl"
    },
    "entryFields": [
      "decision",
      "signature",
      "inputDigest"
    ],
    "keysFiles": {
      "production": "client/keys/production.json, for the gateway https://app.devyonq.ai alone"
    }
  },
  "trust": {
    "item": "trust.{SCOPE}.{sha256 hex of the command}",
    "service": "devyonq-mc",
    "value": "{yes: true, mission, digest, at}",
    "note": "a person's yes to a test command is kept and read under the scope its signed decision carries (decision.digests.scope), never under a scope read from the working tree alone"
  },
  "answers": {
    "job": {
      "type": "object",
      "required": [
        "job",
        "state"
      ],
      "properties": {
        "job": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "asks",
            "done",
            "failed",
            "interrupted",
            "abandoned"
          ]
        },
        "asks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            },
            "exit": {
              "type": "integer"
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "pathForms": {
    "checkout": "a path relative to the top of the checkout, with / between its parts, '.' for the top itself",
    "work": "/~work",
    "store": "/~/.mc17/converge",
    "temp": "/~tmp",
    "engine": "a path of the engine's own copy prints as its package path, relative to the copy's root, such as harness/orchestration-harness.js",
    "scratch": "a path of the engine's scratch folder for the call prints under /~tmp, the client's temporary folder"
  },
  "readKinds": {
    "document": [
      "id"
    ],
    "section": [
      "id",
      "heading"
    ],
    "record": [
      "ledger",
      "n"
    ],
    "tail": [
      "ledger",
      "count"
    ],
    "search": [
      "q"
    ],
    "collection": [
      "id"
    ],
    "collections": [],
    "me": [],
    "versions": [
      "id"
    ],
    "version": [
      "id",
      "version"
    ]
  },
  "fileArguments": {
    "derivedFrom": "the release's own code under engine/core/harness/: each argument a command, or a function it hands its arguments to, gives the file seam (gateway/file-flags.testkit.ts)",
    "files": "a flag whose word names a file: the file is sent, and the word rewritten to the path it was sent at",
    "either": "a flag whose word names a file where one stands at that path: the file is sent and the word rewritten; any other word, such as an asset id, is sent as given",
    "lists": "a flag whose word is a comma-separated list: each part is read as an either flag's word",
    "dirs": "a flag whose word names a folder where one stands: every file under it is sent and the word rewritten; a file there is read as an either flag's word, and any other word is sent as given",
    "positional": "either: each word after the command's own words that the release's parsing leaves positional is read as an either flag's word; the parsing takes the word after a --flag as that flag's value, unless it opens with --",
    "paths": "a flag whose word is a path the command writes: the word is rewritten to its sent form, and nothing is sent"
  },
